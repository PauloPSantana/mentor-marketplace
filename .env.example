# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentorhub
DB_USER=mentorhub
DB_PASSWORD=mentorhub
JWT_SECRET=mentorhub-dev-secret-change-me-in-production-32bytes-min
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Calendar + Meet (nunca commite o client-secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_FRONTEND_REDIRECT=http://localhost:3000/dashboard/mentor

# Zoom (segunda integração)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/zoom/callback
ZOOM_FRONTEND_REDIRECT=http://localhost:3000/dashboard/mentor
ZOOM_WEBHOOK_SECRET=

# E-mail de convite (Gmail SMTP). Sem isso o convite é criado, mas não chega na caixa do mentor.
# 1. Ative verificação em duas etapas na conta Google
# 2. Crie uma Senha de app: https://myaccount.google.com/apppasswords
# 3. Copie backend/mail-local.yml.example para backend/mail-local.yml e preencha
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Mentor Marketplace <noreply@localhost>

# Docker Compose
POSTGRES_DB=mentorhub
POSTGRES_USER=mentorhub
POSTGRES_PASSWORD=mentorhub
POSTGRES_PORT=5432
